# Copy to .env and fill in with your own Supabase / PostgreSQL credentials.
# .env is gitignored — never commit real values.
#
# Only download_data.py needs these. The notebook reads the local
# tiktok_data.db and does not touch the database.

PG_HOST=<your-supabase-host>
PG_PORT=5432
PG_DBNAME=postgres
PG_USER=<your-supabase-user>
PG_PASSWORD=<your-password>
